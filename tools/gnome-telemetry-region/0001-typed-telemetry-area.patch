+
+static gboolean
+telemetry_write (const gchar *line)
+{
+  const gchar *cursor = line;
+  gsize remaining = strlen (line);
+
+  if (screenshot_config == NULL || screenshot_config->telemetry_owner_fd < 0)
+    return FALSE;
+  while (remaining > 0)
+    {
+      ssize_t written = write (screenshot_config->telemetry_owner_fd, cursor, remaining);
+      if (written < 0 && errno == EINTR)
+        continue;
+      if (written <= 0)
+        return FALSE;
+      cursor += written;
+      remaining -= written;
+    }
+  return TRUE;
+}
+
+static gchar *
+telemetry_sha256_file (const gchar *path,
+                       gsize       *length)
+{
+  g_autofree gchar *contents = NULL;
+  gsize size = 0;
+  g_autoptr(GError) error = NULL;
+  GChecksum *checksum;
+
+  if (!g_file_get_contents (path, &contents, &size, &error))
+    return NULL;
+  checksum = g_checksum_new (G_CHECKSUM_SHA256);
+  g_checksum_update (checksum, (const guchar *) contents, size);
+  if (length != NULL)
+    *length = size;
+  return g_strdup (g_checksum_get_string (checksum));
+}
+
+static gchar *
+telemetry_process_start (void)
+{
+  g_autofree gchar *contents = NULL;
+  const gchar *cursor;
+  g_autofree gchar *result = NULL;
+  gchar **fields;
+  g_autoptr(GError) error = NULL;
+
+  if (!g_file_get_contents ("/proc/self/stat", &contents, NULL, &error))
+    return NULL;
+  cursor = strrchr (contents, ')');
+  if (cursor == NULL || cursor[1] != ' ')
+    return NULL;
+  fields = g_strsplit (cursor + 2, " ", 0);
+  if (g_strv_length (fields) <= 19)
+    {
+      g_strfreev (fields);
+      return NULL;
+    }
+  result = g_strdup (fields[19]);
+  g_strfreev (fields);
+  return g_steal_pointer (&result);
+}
+
+static gchar *
+telemetry_digest_string (const gchar *value)
+{
+  return g_compute_checksum_for_string (G_CHECKSUM_SHA256, value, -1);
+}
+
+gboolean
+screenshot_telemetry_owner_ready (GApplication *application)
+{
+  g_autofree gchar *start = NULL;
+  g_autofree gchar *executable = NULL;
+  g_autofree gchar *executable_sha256 = NULL;
+  g_autofree gchar *output_digest = NULL;
+  g_autofree gchar *record = NULL;
+  struct pollfd pollfd = { 0 };
+  gchar ack[256] = { 0 };
+  ssize_t length;
+  gboolean remote;
+
+  if (!screenshot_config->telemetry_region)
+    return TRUE;
+  if (screenshot_config->telemetry_owner_fd < 0 || screenshot_config->telemetry_exec_fd < 0 ||
+      screenshot_config->telemetry_nonce == NULL || screenshot_config->telemetry_output_path == NULL)
+    return FALSE;
+  start = telemetry_process_start ();
+  executable = g_strdup_printf ("/proc/self/fd/%d", screenshot_config->telemetry_exec_fd);
+  executable_sha256 = telemetry_sha256_file (executable, NULL);
+  output_digest = telemetry_digest_string (screenshot_config->telemetry_output_path);
+  remote = g_application_get_is_remote (application);
+  if (start == NULL || executable_sha256 == NULL || output_digest == NULL)
+    return FALSE;
+  record = g_strdup_printf (
+    "{\"type\":\"owner_ready\",\"protocol\":1,\"nonce\":\"%s\","
+    "\"pid\":%d,\"process_start\":\"%s\",\"ppid\":%d,\"pgid\":%d,"
+    "\"exec_fd\":%d,\"executable_sha256\":\"%s\",\"primary_owner\":%s,"
+    "\"remote\":%s,\"branch\":\"ScreenshotArea\",\"rectangle\":[%d,%d,%d,%d],"
+    "\"output_path_digest\":\"%s\"}\n",
+    screenshot_config->telemetry_nonce,
+    (gint) getpid (),
+    start,
+    (gint) getppid (),
+    (gint) getpgrp (),
+    screenshot_config->telemetry_exec_fd,
+    executable_sha256,
+    remote ? "false" : "true",
+    remote ? "true" : "false",
+    screenshot_config->telemetry_x,
+    screenshot_config->telemetry_y,
+    screenshot_config->telemetry_width,
+    screenshot_config->telemetry_height,
+    output_digest);
+  if (!telemetry_write (record))
+    return FALSE;
+
+  pollfd.fd = screenshot_config->telemetry_owner_fd;
+  pollfd.events = POLLIN | POLLHUP | POLLERR;
+  if (poll (&pollfd, 1, 15000) <= 0 || !(pollfd.revents & POLLIN))
+    return FALSE;
+  length = read (screenshot_config->telemetry_owner_fd, ack, sizeof ack - 1);
+  if (length <= 0)
+    return FALSE;
+  ack[length] = '\0';
+  record = g_strdup_printf (
+    "{\"type\":\"ACK\",\"protocol\":1,\"nonce\":\"%s\"}\n",
+    screenshot_config->telemetry_nonce);
+  return g_strcmp0 (ack, record) == 0 && !remote;
+}
+
+gboolean
+screenshot_telemetry_capture_started (void)
+{
+  g_autofree gchar *output_digest = NULL;
+  g_autofree gchar *record = NULL;
+
+  if (!screenshot_config->telemetry_region)
+    return TRUE;
+  output_digest = telemetry_digest_string (screenshot_config->telemetry_output_path);
+  if (output_digest == NULL)
+    return FALSE;
+  record = g_strdup_printf (
+    "{\"type\":\"capture_started\",\"protocol\":1,\"nonce\":\"%s\","
+    "\"branch\":\"ScreenshotArea\",\"rectangle\":[%d,%d,%d,%d],"
+    "\"output_path_digest\":\"%s\",\"capture_started\":%.9f}\n",
+    screenshot_config->telemetry_nonce,
+    screenshot_config->telemetry_x,
+    screenshot_config->telemetry_y,
+    screenshot_config->telemetry_width,
+    screenshot_config->telemetry_height,
+    output_digest,
+    (gdouble) g_get_monotonic_time () / G_USEC_PER_SEC);
+  return telemetry_write (record);
+}
+
+gboolean
+screenshot_telemetry_capture_complete (const gchar *path)
+{
+  g_autofree gchar *output_digest = NULL;
+  g_autofree gchar *image_digest = NULL;
+  g_autofree gchar *record = NULL;
+  gsize length = 0;
+
+  if (!screenshot_config->telemetry_region)
+    return TRUE;
+  output_digest = telemetry_digest_string (screenshot_config->telemetry_output_path);
+  image_digest = telemetry_sha256_file (path, &length);
+  if (output_digest == NULL || image_digest == NULL)
+    return FALSE;
+  record = g_strdup_printf (
+    "{\"type\":\"capture_complete\",\"protocol\":1,\"nonce\":\"%s\","
+    "\"branch\":\"ScreenshotArea\",\"rectangle\":[%d,%d,%d,%d],"
+    "\"output_path_digest\":\"%s\",\"output_sha256\":\"%s\",\"output_bytes\":%" G_GSIZE_FORMAT "}\n",
+    screenshot_config->telemetry_nonce,
+    screenshot_config->telemetry_x,
+    screenshot_config->telemetry_y,
+    screenshot_config->telemetry_width,
+    screenshot_config->telemetry_height,
+    output_digest,
+    image_digest,
+    length);
+  return telemetry_write (record);
+}
+
+static gboolean
+telemetry_option_value (const gchar *argument,
+                        const gchar *name,
+                        gint        *value,
+                        gint        *index,
+                        gint         argc,
+                        gchar      **argv)
+{
+  const gchar *raw = NULL;
+  gchar *end = NULL;
+  gint64 parsed;
+
+  if (g_strcmp0 (argument, name) == 0 && *index + 1 < argc)
+    raw = argv[++*index];
+  else if (g_str_has_prefix (argument, name) &&
+           argument[strlen (name)] == '=')
+    raw = argument + strlen (name) + 1;
+  if (raw == NULL || raw[0] == '\0')
+    return FALSE;
+  errno = 0;
+  parsed = g_ascii_strtoll (raw, &end, 10);
+  if (errno != 0 || end == raw || *end != '\0' ||
+      parsed < G_MININT || parsed > G_MAXINT)
+    return FALSE;
+  *value = (gint) parsed;
+  return TRUE;
+}
+
+gboolean
+screenshot_validate_telemetry_argv (int argc, char **argv)
+{
+  gboolean telemetry = FALSE;
+  gint telemetry_count = 0;
+  gint x = 0, y = 0, width = 0, height = 0, owner_fd = -1, exec_fd = -1;
+  gint x_count = 0, y_count = 0, width_count = 0, height_count = 0;
+  gint owner_count = 0, exec_count = 0, nonce_count = 0, file_count = 0;
+  gboolean values_valid = TRUE;
+  gchar *nonce = NULL;
+  gchar *file_path = NULL;
+
+  for (gint index = 1; index < argc; index++)
+    {
+      const gchar *argument = argv[index];
+      if (g_strcmp0 (argument, "--telemetry-region") == 0)
+        telemetry = TRUE, telemetry_count++;
+      else if (g_strcmp0 (argument, "--telemetry-x") == 0 ||
+               g_str_has_prefix (argument, "--telemetry-x="))
+        x_count++, values_valid &= telemetry_option_value (
+          argument, "--telemetry-x", &x, &index, argc, argv);
+      else if (g_strcmp0 (argument, "--telemetry-y") == 0 ||
+               g_str_has_prefix (argument, "--telemetry-y="))
+        y_count++, values_valid &= telemetry_option_value (
+          argument, "--telemetry-y", &y, &index, argc, argv);
+      else if (g_strcmp0 (argument, "--telemetry-width") == 0 ||
+               g_str_has_prefix (argument, "--telemetry-width="))
+        width_count++, values_valid &= telemetry_option_value (
+          argument, "--telemetry-width", &width, &index, argc, argv);
+      else if (g_strcmp0 (argument, "--telemetry-height") == 0 ||
+               g_str_has_prefix (argument, "--telemetry-height="))
+        height_count++, values_valid &= telemetry_option_value (
+          argument, "--telemetry-height", &height, &index, argc, argv);
+      else if (g_strcmp0 (argument, "--telemetry-owner-fd") == 0 ||
+               g_str_has_prefix (argument, "--telemetry-owner-fd="))
+        owner_count++, values_valid &= telemetry_option_value (
+          argument, "--telemetry-owner-fd", &owner_fd, &index, argc, argv);
+      else if (g_strcmp0 (argument, "--telemetry-exec-fd") == 0 ||
+               g_str_has_prefix (argument, "--telemetry-exec-fd="))
+        exec_count++, values_valid &= telemetry_option_value (
+          argument, "--telemetry-exec-fd", &exec_fd, &index, argc, argv);
+      else if (g_strcmp0 (argument, "--telemetry-nonce") == 0 ||
+               g_str_has_prefix (argument, "--telemetry-nonce="))
+        {
+          nonce_count++;
+          if (g_strcmp0 (argument, "--telemetry-nonce") == 0 &&
+              index + 1 < argc)
+            nonce = g_strdup (argv[++index]);
+          else if (g_str_has_prefix (argument, "--telemetry-nonce="))
+            nonce = g_strdup (argument + strlen ("--telemetry-nonce="));
+          if (nonce == NULL || nonce[0] == '\0')
+            values_valid = FALSE;
+        }
+      else if (g_strcmp0 (argument, "--file") == 0 ||
+               g_str_has_prefix (argument, "--file="))
+        {
+          file_count++;
+          if (g_strcmp0 (argument, "--file") == 0 && index + 1 < argc)
+            file_path = g_strdup (argv[++index]);
+          else if (g_str_has_prefix (argument, "--file="))
+            file_path = g_strdup (argument + strlen ("--file="));
+          if (file_path == NULL || file_path[0] == '\0')
+            values_valid = FALSE;
+        }
+      else if (g_strcmp0 (argument, "--window") == 0 ||
+               g_strcmp0 (argument, "--area") == 0 ||
+               g_strcmp0 (argument, "--interactive") == 0 ||
+               g_strcmp0 (argument, "--clipboard") == 0 ||
+               g_strcmp0 (argument, "--include-pointer") == 0 ||
+               g_strcmp0 (argument, "--delay") == 0 ||
+               g_str_has_prefix (argument, "--delay="))
+        values_valid = FALSE;
+      else if (g_str_has_prefix (argument, "--"))
+        values_valid = FALSE;
+    }
+
+  if (!telemetry && (telemetry_count || x_count || y_count || width_count ||
+                     height_count || owner_count || exec_count || nonce_count))
+    {
+      g_printerr ("Telemetry options require --telemetry-region.\n");
+      g_free (nonce);
+      g_free (file_path);
+      return FALSE;
+    }
+  if (!telemetry)
+    {
+      g_free (nonce);
+      g_free (file_path);
+      return TRUE;
+    }
+  if (telemetry_count != 1 || x_count != 1 || y_count != 1 ||
+      width_count != 1 || height_count != 1 || owner_count != 1 ||
+      exec_count != 1 || nonce_count != 1 || file_count != 1 ||
+      !values_valid || width != 256 || height != 256 || owner_fd <= 2 ||
+      exec_fd <= 2 || nonce == NULL || nonce[0] == '\0' ||
+      file_path == NULL || !g_path_is_absolute (file_path))
+    {
+      g_printerr (
+        "Telemetry mode requires one valid 256x256 rectangle, owner channel, nonce, and absolute file.\n");
+      g_free (nonce);
+      g_free (file_path);
+      return FALSE;
+    }
+  g_free (nonce);
+  g_free (file_path);
+  return TRUE;
+}
