[Unit]
Description=Crowley read-only collection health check

[Service]
Type=oneshot
WorkingDirectory=%h/repos/pegasus
ExecStart=%h/repos/pegasus/.venv/bin/python -m tools.crowley_ops health --repo %h/repos/pegasus --config %h/.config/crowley/session.toml --state-root %h/.local/state/crowley/host-operations --backup-root %h/.local/state/crowley/market-backups
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=30s

