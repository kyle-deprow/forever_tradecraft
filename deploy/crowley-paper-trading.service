[Unit]
Description=Crowley paper trading replay

[Service]
Type=oneshot
WorkingDirectory=%h/repos/pegasus
# CROWLEY_DATABASE_URL (with the password) comes from the untracked deploy/.env;
# the run name from deploy/config/paper.env (linked from ~/.config/crowley/paper.env).
EnvironmentFile=%h/repos/pegasus/deploy/.env
EnvironmentFile=%h/.config/crowley/paper.env
ExecStart=%h/repos/pegasus/.venv/bin/python -m crowley.trading paper-step --name ${CROWLEY_PAPER_RUN}
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=14min
