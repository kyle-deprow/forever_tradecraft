# Install: ln -sf %h/repos/pegasus/deploy/crowley-companion.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now crowley-companion
# Settings: deploy/config/companion.toml (linked from ~/.config/crowley/companion.toml).
# The API token (CROWLEY_API_TOKEN) comes from the untracked deploy/.env.
[Unit]
Description=Crowley companion (WoW SavedVariables to local Crowley API)
After=network-online.target

[Service]
WorkingDirectory=/home/dev/repos/pegasus
EnvironmentFile=/home/dev/repos/pegasus/deploy/.env
ExecStart=/home/dev/.local/bin/uv run --no-sync crowley-companion run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
