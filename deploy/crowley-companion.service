# Install: cp deploy/crowley-companion.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now crowley-companion
[Unit]
Description=Crowley companion (WoW SavedVariables <-> Crowley server)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/crowley-companion run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
