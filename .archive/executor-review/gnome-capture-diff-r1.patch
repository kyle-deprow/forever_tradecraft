+def _validate_complete_png(path: Path, expected_size: tuple[int, int]) -> None:
+    """Require a newly written PNG whose bytes can be fully decoded."""
+
+    try:
+        from PIL import Image
+
+        with Image.open(path) as image:
+            if image.format != "PNG" or image.size != expected_size:
+                raise DriverError("GNOME screenshot dimensions or format are invalid")
+            image.verify()
+        with Image.open(path) as image:
+            if image.format != "PNG" or image.size != expected_size:
+                raise DriverError("GNOME screenshot dimensions or format changed")
+            image.load()
+    except DriverError:
+        raise
+    except (FileNotFoundError, OSError, SyntaxError, ValueError) as exc:
+        raise DriverError(f"GNOME screenshot is not a complete PNG: {exc}") from exc
+
+
+def _wait_for_complete_png(path: Path, expected_size: tuple[int, int], deadline_monotonic: float) -> None:
+    last_error = "output is not present yet"
+    while True:
+        try:
+            _validate_complete_png(path, expected_size)
+            return
+        except DriverError as exc:
+            last_error = str(exc)
+        remaining = deadline_monotonic - time.monotonic()
+        if remaining <= 0:
+            raise DriverError(f"GNOME screenshot did not become a complete PNG before deadline: {last_error}")
+        time.sleep(min(0.01, remaining))
 
 
