+        _generation: int,
+        previous: MotionFrame | None = None,
+        *,
+        after_release: bool = False,
+        **_kwargs,
+    ) -> MotionFrame:
+        if after_release:
+            return after
+        return confirmed if previous is not None else before
+
+    daemon._observe_motion = observe_motion
