+        heading = math.atan2(target_y - frame.y, target_x - frame.x) - daemon._world_forward_heading(frame)
+        heading = (heading + math.pi) % (2.0 * math.pi) - math.pi
+        return RouteEvidence(
+            "client-1",
+            frame.capture_monotonic + 0.01,
+            "world",
+            "clear",
+            True,
+            True,
