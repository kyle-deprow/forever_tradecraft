+def test_process_executable_candidate_exit_after_cmdline_is_rejected_and_omitted(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    prefix = tmp_path / "wine-prefix"
+    prefix.mkdir()
+    loader = _fixture_loader(tmp_path)
+    backend = _process_backend(tmp_path, prefix)
+    with _fixture_process(
+        tmp_path,
+        loader,
+        argv0=_FIXTURE_EXECUTABLE,
+        comm=_FIXTURE_EXECUTABLE,
+        wine_prefix=prefix,
+    ) as (process, _control):
+        original_read_bytes = Path.read_bytes
+        cmdline_path = f"/proc/{process.pid}/cmdline"
+        cmdline_read = threading.Event()
+        release_read = threading.Event()
+
+        def stop_after_cmdline(path: Path, *args: object, **kwargs: object) -> bytes:
+            data = original_read_bytes(path, *args, **kwargs)
+            if str(path) == cmdline_path:
+                cmdline_read.set()
+                assert release_read.wait(timeout=3)
+            return data
+
+        monkeypatch.setattr(Path, "read_bytes", stop_after_cmdline)
+        errors: list[BaseException] = []
+
+        def inspect() -> None:
+            try:
+                backend._process_executable(process.pid)
+            except BaseException as exc:
+                errors.append(exc)
+
+        worker = threading.Thread(target=inspect)
+        worker.start()
+        assert cmdline_read.wait(timeout=3)
+        process.terminate()
+        process.wait(timeout=3)
+        release_read.set()
+        worker.join(timeout=3)
+        assert not worker.is_alive()
+        assert len(errors) == 1
+        assert isinstance(errors[0], DriverError)
+        assert str(errors[0]) == f"cannot inspect game process {process.pid}"
+        assert process.pid not in backend._matching_game_pids()
+
+
+@pytest.mark.parametrize(
+    ("start_argv0", "start_comm", "next_argv0", "next_comm", "initial_error"),
+    [
+        (
+            "OtherFixture.bin",
+            "OtherFixture",
+            _FIXTURE_EXECUTABLE,
+            _FIXTURE_EXECUTABLE,
+            "game PID does not expose the configured Windows executable",
+        ),
+        (
+            _FIXTURE_EXECUTABLE,
+            _FIXTURE_EXECUTABLE,
+            "OtherFixture.bin",
+            "OtherFixture",
+            "game PID has an unexpected Linux process identity",
+        ),
+    ],
+)
+def test_process_executable_exec_transition_never_accepts_mixed_generation(
+    start_argv0: str,
+    start_comm: str,
+    next_argv0: str,
+    next_comm: str,
+    initial_error: str,
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    prefix = tmp_path / "wine-prefix"
+    prefix.mkdir()
+    loader = _fixture_loader(tmp_path)
+    backend = _process_backend(tmp_path, prefix)
+    with _fixture_process(
+        tmp_path,
+        loader,
+        argv0=start_argv0,
+        comm=start_comm,
+        wine_prefix=prefix,
+        transition=(next_argv0, next_comm),
+    ) as (process, control):
+        assert control is not None
+        original_read_bytes = Path.read_bytes
+        cmdline_path = f"/proc/{process.pid}/cmdline"
+        cmdline_read = threading.Event()
+        release_read = threading.Event()
+
+        def stop_after_cmdline(path: Path, *args: object, **kwargs: object) -> bytes:
+            data = original_read_bytes(path, *args, **kwargs)
+            if str(path) == cmdline_path:
+                cmdline_read.set()
+                assert release_read.wait(timeout=3)
+            return data
+
+        monkeypatch.setattr(Path, "read_bytes", stop_after_cmdline)
+        errors: list[BaseException] = []
+
+        def inspect() -> None:
+            try:
+                backend._process_executable(process.pid)
+            except BaseException as exc:
+                errors.append(exc)
+
+        worker = threading.Thread(target=inspect)
+        worker.start()
+        assert cmdline_read.wait(timeout=3)
+        os.write(control, b"transition\n")
+        assert process.stdout is not None
+        assert process.stdout.readline() == f"{next_comm}\n".encode()
+        release_read.set()
+        worker.join(timeout=3)
+        assert not worker.is_alive()
+        assert len(errors) == 1
+        assert isinstance(errors[0], DriverError)
+        assert str(errors[0]) == initial_error
+
+        if next_argv0 == _FIXTURE_EXECUTABLE:
+            assert backend._process_executable(process.pid)[0] == _FIXTURE_EXECUTABLE
+        else:
+            with pytest.raises(DriverError, match="configured Windows executable"):
+                backend._process_executable(process.pid)
+
