+def _record_process_reads(monkeypatch: pytest.MonkeyPatch, pid: int) -> list[str]:
+    prefix = f"/proc/{pid}/"
+    reads: list[str] = []
+    original_read_bytes = Path.read_bytes
+    original_read_text = Path.read_text
+    original_readlink = os.readlink
+
+    def read_bytes(path: Path, *args: object, **kwargs: object) -> bytes:
+        if str(path).startswith(prefix):
+            reads.append(Path(path).name)
+        return original_read_bytes(path, *args, **kwargs)
+
+    def read_text(path: Path, *args: object, **kwargs: object) -> str:
+        if str(path).startswith(prefix):
+            reads.append(Path(path).name)
+        return original_read_text(path, *args, **kwargs)
+
+    def readlink(path: str | bytes, *args: object) -> str | bytes:
+        if str(path).startswith(prefix):
+            reads.append(Path(path).name)
+        return original_readlink(path, *args)
+
+    monkeypatch.setattr(Path, "read_bytes", read_bytes)
+    monkeypatch.setattr(Path, "read_text", read_text)
+    monkeypatch.setattr(os, "readlink", readlink)
+    return reads
