+def _fixture_loader(tmp_path: Path, name: str = "wine-preloader") -> Path:
+    loader = tmp_path / name
+    shutil.copyfile("/usr/bin/python3", loader)
+    loader.chmod(0o700)
+    return loader
+
+
+@contextmanager
+def _fixture_process(
+    tmp_path: Path,
+    loader: Path,
+    *,
+    argv0: str,
+    comm: str,
+    wine_prefix: Path,
+    duplicate: bool = False,
+    transition: tuple[str, str] | None = None,
+):
+    read_fd: int | None = None
+    write_fd: int | None = None
+    process: subprocess.Popen[bytes] | None = None
+    try:
+        environment = os.environ.copy()
+        environment.update(
+            {
+                "FIXTURE_CODE": _FIXTURE_CODE,
+                "FIXTURE_COMM": comm,
+                "FIXTURE_EXPECTED": _FIXTURE_EXECUTABLE,
+                "FIXTURE_LOADER": str(loader),
+                "WINEPREFIX": str(wine_prefix),
+            }
+        )
+        if transition is not None:
+            read_fd, write_fd = os.pipe()
+            os.set_inheritable(read_fd, True)
+            environment.update(
+                {
+                    "FIXTURE_CONTROL_FD": str(read_fd),
+                    "FIXTURE_NEXT_ARGV0": transition[0],
+                    "FIXTURE_NEXT_COMM": transition[1],
+                }
+            )
+        args = [argv0, "-c", _FIXTURE_CODE]
+        if duplicate:
+            args.append(_FIXTURE_EXECUTABLE)
+        process = subprocess.Popen(
+            args,
+            executable=str(loader),
+            env=environment,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            start_new_session=True,
+            pass_fds=(read_fd,) if read_fd is not None else (),
+        )
+        if read_fd is not None:
+            os.close(read_fd)
+            read_fd = None
+        assert process.stdout is not None
+        ready = process.stdout.readline()
+        if ready != f"{comm}\n".encode():
+            assert process.stderr is not None
+            raise AssertionError((process.poll(), process.stderr.read().decode(errors="replace")))
+        yield process, write_fd
+    finally:
+        if read_fd is not None:
+            os.close(read_fd)
+        if write_fd is not None:
+            os.close(write_fd)
+        if process is not None:
+            if process.poll() is None:
+                process.terminate()
+            try:
+                process.wait(timeout=3)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait(timeout=3)
+            if process.stdout is not None:
+                process.stdout.close()
+            if process.stderr is not None:
+                process.stderr.close()
+
