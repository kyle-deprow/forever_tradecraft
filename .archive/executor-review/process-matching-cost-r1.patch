+_FIXTURE_EXECUTABLE = "CrowleyTest.exe"
+_FIXTURE_CODE = (
+    "import ctypes, os, time\n"
+    "comm = os.environ['FIXTURE_COMM'].encode()\n"
+    "ctypes.CDLL(None).prctl(15, comm, 0, 0, 0)\n"
+    "os.write(1, comm + b'\\n')\n"
+    "control = os.environ.get('FIXTURE_CONTROL_FD')\n"
+    "if control:\n"
+    "    while True:\n"
+    "        command = os.read(int(control), 128).strip().decode()\n"
+    "        if command:\n"
+    "            environment = dict(os.environ)\n"
+    "            environment['FIXTURE_COMM'] = environment['FIXTURE_NEXT_COMM']\n"
+    "            os.execve(environment['FIXTURE_LOADER'], [environment['FIXTURE_NEXT_ARGV0'], '-c', environment['FIXTURE_CODE']], environment)\n"
+    "else:\n"
+    "    while True:\n"
+    "        time.sleep(1)\n"
+)
