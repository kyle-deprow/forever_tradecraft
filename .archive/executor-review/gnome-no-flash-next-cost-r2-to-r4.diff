+def derive_intervals(entry: dict[str, Any]) -> dict[str, Any]:
+    """Derive same-clock, non-overlapping marker buckets without subtraction guesses."""
+    markers = entry.get('diagnostic_markers')
+    if not isinstance(markers, list) or len(markers) != len(MARKER_EVENTS):
+        raise IntervalError('interval derivation requires one complete marker stream')
+    start = entry.get('start_monotonic')
+    end = entry.get('end_monotonic')
+    if not isinstance(start, (int, float)) or isinstance(start, bool):
+        raise IntervalError('command start monotonic time is malformed')
+    if not isinstance(end, (int, float)) or isinstance(end, bool):
+        raise IntervalError('command end monotonic time is malformed')
+    times: dict[str, float] = {}
+    for index, row in enumerate(markers):
+        if not isinstance(row, dict) or row.get('event') != MARKER_EVENTS[index]:
+            raise IntervalError('marker event sequence is invalid for interval derivation')
+        mono_ns = row.get('mono_ns')
+        if not isinstance(mono_ns, int) or isinstance(mono_ns, bool) or mono_ns < 0:
+            raise IntervalError('marker monotonic timestamp is malformed')
+        times[MARKER_EVENTS[index]] = mono_ns / 1_000_000_000.0
+    first = times[MARKER_EVENTS[0]]
+    last = times[MARKER_EVENTS[-1]]
+    if start > first or last > end or start > end:
+        raise IntervalError('marker boundaries fall outside command monotonic interval')
+    intervals: list[dict[str, Any]] = []
+
+    def add(label: str, left: float, right: float, left_event: str, right_event: str) -> None:
+        if left > right:
+            raise IntervalError(f'interval {label} is negative or overlaps')
+        intervals.append({
+            'label': label, 'start_monotonic': left, 'end_monotonic': right,
+            'duration_s': right - left, 'from': left_event, 'to': right_event,
+        })
+
+    add('pre_main', float(start), first, 'command_start', MARKER_EVENTS[0])
+    for left_event, right_event in zip(MARKER_EVENTS, MARKER_EVENTS[1:]):
+        label = _INTERVAL_LABELS.get((left_event, right_event))
+        if label is None:
+            raise IntervalError(f'no semantic label for {left_event}->{right_event}')
+        add(label, times[left_event], times[right_event], left_event, right_event)
+    add('post_run_return_tail', last, float(end), MARKER_EVENTS[-1], 'command_end')
+    for previous, current in zip(intervals, intervals[1:]):
+        if previous['end_monotonic'] > current['start_monotonic']:
+            raise IntervalError('derived intervals overlap')
+    observed = float(end) - float(start)
+    summed = sum(float(item['duration_s']) for item in intervals)
+    if abs(summed - observed) > 1e-9:
+        raise IntervalError('derived interval sum does not equal command elapsed time')
+    empty_rows = []
+    for left_event, right_event in _MARKER_COST_EMPTY_PAIRS:
+        row = next(item for item in intervals if item['from'] == left_event and item['to'] == right_event)
+        empty_rows.append({'from': left_event, 'to': right_event, 'duration_s': row['duration_s']})
+    return {
+        'intervals': intervals,
+        'observed_elapsed_s': observed,
+        'sum_elapsed_s': summed,
+        'sum_matches': True,
+        'marker_cost_empty_pairs': empty_rows,
+        'sampled_empty_pair_total_s': sum(item['duration_s'] for item in empty_rows),
+        'sampled_empty_pair_max_s': max(item['duration_s'] for item in empty_rows),
+        'clock': 'CLOCK_MONOTONIC',
+    }
+
+def sample_attempt_decision(
+    ordinal: int,
+    *,
+    capture_error: BaseException | None = None,
+    image_error: str | None = None,
+    screenshot_command_count: int = 1,
+    owner_proof: bool = True,
+    marker_error: dict[str, Any] | None = None,
+) -> tuple[str, str]:
+    """Return the production loop decision without performing another attempt."""
+    if capture_error is not None:
+        return 'fail', f'{type(capture_error).__name__}: {capture_error}'
+    if image_error:
+        return 'fail', image_error
+    if screenshot_command_count != 1:
+        return 'fail', 'sample did not execute exactly one screenshot command'
+    if not owner_proof:
+        return 'fail', 'request owner evidence missing'
+    if marker_error:
+        message = str(marker_error.get('message', 'diagnostic marker validation failed'))
+        if marker_error.get('retryable') and ordinal == 0:
+            return 'retry', message
+        return 'fail', message
+    return 'complete', ''
 
