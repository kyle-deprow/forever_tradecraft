+def test_gtk_command_recorder_keeps_only_scoped_rows_across_readiness_trees(
+    tmp_path: Path,
+) -> None:
+    helper = _helper_module()
+    pid = os.getpid()
+    client = 0x600119
+    frame = 0x600192
+    helper_xid = 0x600193
+    startup_tree = (
+        "xwininfo: Window id: 0x374 (the root window)\n"
+        f'  {hex(client)} "CROWLEY INPUT CALIBRATION ONLY": ("-c" "-c") '
+        "480x240+753+456  +753+456\n"
+        '  0x700001 "unrelated desktop marker": ("other" "other") 1x1+1+1  +1+1\n'
+    )
+    ready_tree = (
+        "xwininfo: Window id: 0x374 (the root window)\n"
+        f'  {hex(frame)} "CROWLEY INPUT CALIBRATION ONLY": '
+        '("mutter-x11-frames" "mutter-x11-frames") 602x401+692+362  +692+362\n'
+        f'    {hex(client)} "CROWLEY INPUT CALIBRATION ONLY": ("-c" "-c") '
+        "480x240+753+456  +753+456\n"
+        f"    {hex(helper_xid)} (has no name): () 1x1+-1+-1  +691+361\n"
+    )
+    trees = iter((startup_tree, ready_tree))
+    calls: list[list[str]] = []
+
+    def command(argv: list[str], **_kwargs: object) -> str:
+        calls.append(argv)
+        if argv == ["wmctrl", "-lp"]:
+            return (
+                f"{hex(client)}  -1 {pid} host CROWLEY INPUT CALIBRATION ONLY\n"
+                "0x700001  -1 999 host unrelated desktop marker\n"
+            )
+        if argv == ["xwininfo", "-root", "-tree"]:
+            return next(trees)
+        raise AssertionError(argv)
+
+    path = tmp_path / "readiness.jsonl"
+    recorder = helper.OwnedGtkCommandRecorder(command, path)
+    recorder.note_gtk_pid(pid)
+    wmctrl_result = recorder(["wmctrl", "-lp"], display=":test", xauthority="Xauthority")
+    first_tree = recorder(["xwininfo", "-root", "-tree"], display=":test", xauthority="Xauthority")
+    second_tree = recorder(["xwininfo", "-root", "-tree"], display=":test", xauthority="Xauthority")
+    recorder.close()
+
+    text = path.read_text(encoding="utf-8")
+    records = [json.loads(line) for line in text.splitlines()]
+    wmctrl = next(record for record in records if record.get("argv") == ["wmctrl", "-lp"])
+    branches = [record for record in records if record.get("kind") == "live-frame-branch"]
+    assert wmctrl["wmctrlLineCount"] == 2
+    assert len(wmctrl["admittedWmctrlRows"]) == 1
+    assert "unrelated desktop marker" in wmctrl_result
+    assert "unrelated desktop marker" in first_tree
+    assert "unrelated desktop marker" not in second_tree
+    assert "unrelated desktop marker" not in text
+    assert [branch["state"] for branch in branches] == ["startup-unreparented", "ready-candidate"]
+    assert len([record for record in records if record.get("argv") == ["xwininfo", "-root", "-tree"]]) == 2
 
 
