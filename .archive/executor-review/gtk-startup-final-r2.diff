+@pytest.mark.parametrize("state", ["startup-unreparented", "ready"])
+def test_gtk_command_recorder_is_passive_and_scopes_the_owned_branch(tmp_path: Path, state: str) -> None:
+    helper = _helper_module()
+    pid = os.getpid()
+    client = 0x600119
+    frame = 0x600192
+    helper_xid = 0x600193
+    unrelated = 0x700001
+    calls: list[list[str]] = []
+    if state == "startup-unreparented":
+        tree = (
+            "xwininfo: Window id: 0x374 (the root window)\n"
+            f'  {hex(client)} "CROWLEY INPUT CALIBRATION ONLY": ("-c" "-c") '
+            "480x240+753+456  +753+456\n"
+            f'  {hex(unrelated)} "other desktop window": ("other" "other") 1x1+1+1  +1+1\n'
+        )
+    else:
+        tree = (
+            "xwininfo: Window id: 0x374 (the root window)\n"
+            f'  {hex(frame)} "CROWLEY INPUT CALIBRATION ONLY": '
+            '("mutter-x11-frames" "mutter-x11-frames") 602x401+692+362  +692+362\n'
+            f'    {hex(client)} "CROWLEY INPUT CALIBRATION ONLY": ("-c" "-c") '
+            "480x240+753+456  +753+456\n"
+            f"    {hex(helper_xid)} (has no name): () 1x1+-1+-1  +691+361\n"
+            f'  {hex(unrelated)} "other desktop window": ("other" "other") 1x1+1+1  +1+1\n'
+        )
+
+    def command(argv: list[str], **_kwargs: object) -> str:
+        calls.append(argv)
+        if argv == ["wmctrl", "-lp"]:
+            return f"{hex(client)}  -1 {pid} host CROWLEY INPUT CALIBRATION ONLY\n"
+        if argv == ["xwininfo", "-root", "-tree"]:
+            return tree
+        raise AssertionError(argv)
+
+    path = tmp_path / f"{state}.jsonl"
+    recorder = helper.OwnedGtkCommandRecorder(command, path)
+    recorder.note_gtk_pid(pid)
+    recorder(["wmctrl", "-lp"], display=":test", xauthority="Xauthority")
+    recorder(["xwininfo", "-root", "-tree"], display=":test", xauthority="Xauthority")
+    recorder.close()
+
+    assert calls == [["wmctrl", "-lp"], ["xwininfo", "-root", "-tree"]]
+    records = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines()]
+    branch = next(record for record in records if record.get("kind") == "live-frame-branch")
+    assert branch["clientXid"] == client
+    assert branch["rootXid"] == 0x374
+    assert hex(unrelated) not in str(branch)
+    assert "mutterProcesses" not in branch
+    if state == "startup-unreparented":
+        assert branch["state"] == "startup-unreparented"
+        assert "frameXid" not in branch
+    else:
+        assert branch["frameXid"] == frame
+        assert branch["frameXid"] != branch["rootXid"]
+
