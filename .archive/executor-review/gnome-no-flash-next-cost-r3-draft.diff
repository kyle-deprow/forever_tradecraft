+def sample_attempt_decision(
+    ordinal: int,
+    *,
+    capture_error: BaseException | None = None,
+    image_error: str | None = None,
+    screenshot_command_count: int = 1,
+    owner_proof: bool = True,
+    marker_error: dict[str, Any] | None = None,
+) -> tuple[str, str]:
+    """Return the production loop decision without performing another attempt."""
+    if capture_error is not None:
+        return 'fail', f'{type(capture_error).__name__}: {capture_error}'
+    if image_error:
+        return 'fail', image_error
+    if screenshot_command_count != 1:
+        return 'fail', 'sample did not execute exactly one screenshot command'
+    if not owner_proof:
+        return 'fail', 'request owner evidence missing'
+    if marker_error:
+        message = str(marker_error.get('message', 'diagnostic marker validation failed'))
+        if marker_error.get('retryable') and ordinal == 0:
+            return 'retry', message
+        return 'fail', message
+    return 'complete', ''
