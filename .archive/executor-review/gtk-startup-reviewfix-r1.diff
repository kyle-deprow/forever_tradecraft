+
+    def command(args: list[str], **kwargs: object) -> str:
+        nonlocal attempts
+        command_timeouts.append(float(kwargs["timeout"]))
+        clock[0] += 0.005
+        if args[:2] == ["wmctrl", "-lp"]:
+            attempts += 1
+            return f"{hex(TARGET)} -1 {pid} host CROWLEY INPUT CALIBRATION ONLY\n"
+        phase = attempts - 1
+        if phase == 0 and args == ["xprop", "-id", hex(TARGET)]:
